# Google AI Studio API Key — used for BOTH the story text AND the scene images.
# Image generation (Nano Banana models) generally requires the paid tier /
# billing enabled on your Google Cloud project: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: override the primary image model / output size.
# GEMINI_IMAGE_MODEL=gemini-nano-banana-2.1
# GEMINI_IMAGE_SIZE=1K   # 1K | 2K | 4K (higher = sharper but costs more)

# --- Cheap / free testing ---
# Scenes per episode = images per run. Lower it for a cheap smoke test.
# NUM_SCENES=2
# Image backend: auto | gemini | pollinations | hf
# Use "hf" for a $0 free-tier run (free FLUX.1-schnell Space; Gemini images
# need paid billing, so free-tier text + hf images = a fully free test video).
# IMAGE_PROVIDER=hf

# Accepted final Short duration in seconds (YouTube Shorts allow up to 180).
# MIN_DURATION_SEC=30
# MAX_DURATION_SEC=180

# Optional image fallbacks (pipeline runs on Gemini alone without these):
# Hugging Face token for the free FLUX.1-schnell Space fallback.
# HF_TOKEN=hf_your_token_here
# Pollinations API key (their free endpoint now returns 402 without a key).
# POLLINATIONS_API_KEY=your_pollinations_key_here

# YouTube OAuth2 Credentials (from Google Cloud Console)
# Each language channel needs its own OAuth token file
YT_CLIENT_SECRET_FILE=client_secret.json

# Meta (Facebook Pages + Instagram) Reels publishing.
# JSON string keyed by language code (kn/te/hi); each with fb_page_id,
# ig_user_id (IG Business/Creator account), and a PERMANENT page_access_token.
# In GitHub Actions this is the repository secret META_CREDENTIALS_JSON.
# For local testing you may instead drop a META_CREDENTIALS.json file in the repo root (gitignored).
# META_CREDENTIALS_JSON={"kn":{"fb_page_id":"...","ig_user_id":"...","page_access_token":"..."}, ...}
# Optional: pin a specific Graph API version (default v23.0)
# META_GRAPH_VERSION=v23.0

# Voice / Text-to-Speech engine.
# "gemini" (default) = natural, expressive, emotion-aware Gemini 3.8 TTS (uses GEMINI_API_KEY),
#   with automatic fallback to free edge-tts on any error/quota. "edge" = force edge-tts only.
# TTS_ENGINE=gemini
# Optional: pin the Gemini TTS model
# GEMINI_TTS_MODEL=gemini-3.8-flash-tts
# Optional: override the Gemini prebuilt narrator voice per language (30 voices available)
# KN_GEMINI_VOICE=Charon
# TE_GEMINI_VOICE=Rasalgethi
# HI_GEMINI_VOICE=Algenib

# Optional: Override default edge-tts fallback voice names
# KN_VOICE=kn-IN-GaganNeural
# TE_VOICE=te-IN-MohanNeural
# HI_VOICE=hi-IN-MadhurNeural
